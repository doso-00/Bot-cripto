# Segreti: mai versionare
.env
.env.*
!.env.example

# Dati, report e log generati (non versionati, vedi brief §3.2)
/data/
/reports/
/logs/
*.duckdb
*.duckdb.wal

# Kill switch manuale: file locale, non va mai committato
/STOP


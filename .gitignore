__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
dist/
build/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Area di lavoro locale degli agenti (non versionata)
/.superpowers/

# Output generato della dashboard azioni
/out/

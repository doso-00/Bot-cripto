# Modello delle variabili d'ambiente. Copiare in .env (escluso da git) e compilare.
# Mai inserire chiavi reali in questo file.

# Modalità: backtest (default) | paper | live
TRADING_MODE=backtest

# Chiavi del Binance Spot Testnet (Fase 4)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Chiavi reali: restano vuote fino alla Fase 5
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
